<Project>
  <!--
    Deliberately empty, and deliberately does NOT import the repository-root
    Directory.Build.props.

    MSBuild stops walking up the directory tree at the first Directory.Build.props
    it finds, so this file shields the legacy net48 tree from the root file's
    net10.0 / nullable / warnings-as-errors defaults.

    Removed in Phase 6 together with the rest of src/.
  -->

  <PropertyGroup>
    <!-- Directory.Packages.props has its own discovery walk, and NuGet re-sets
         ManagePackageVersionsCentrally after this file is imported. Suppressing
         the import itself is the opt-out that actually sticks. -->
    <ImportDirectoryPackagesProps>false</ImportDirectoryPackagesProps>
  </PropertyGroup>

</Project>
