<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>gumpstudio</AssemblyName>
    <RootNamespace>GumpStudio.Cli</RootNamespace>
    <Description>Headless tooling: dump client art to PNG, convert legacy .gump files, run exporters without the UI.</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../GumpStudio.Core/GumpStudio.Core.csproj" />
    <ProjectReference Include="../GumpStudio.Rendering/GumpStudio.Rendering.csproj" />
    <ProjectReference Include="../GumpStudio.Plugins.Pol/GumpStudio.Plugins.Pol.csproj" />
  </ItemGroup>

</Project>
