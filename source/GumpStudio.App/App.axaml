<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GumpStudio.App.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <!--
      Dock rebuilds the control for a dockable whenever it is moved to another
      dock. The panels are declared once in MainWindow.axaml and held by name,
      so they have to be the same instances afterwards: recycling by dockable
      id hands the existing control back instead of asking for a second one.
    -->
    <ControlRecycling x:Key="ControlRecyclingKey" TryToUseIdAsKey="True" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <DockFluentTheme />

    <Style Selector="DockControl">
      <Setter Property="(ControlRecyclingDataTemplate.ControlRecycling)"
              Value="{StaticResource ControlRecyclingKey}" />
    </Style>

    <Style Selector="ScrollBar">
      <Setter Property="AllowAutoHide" Value="False" />
    </Style>

    <Style Selector="ScrollBar:vertical">
      <Setter Property="Width" Value="14" />
    </Style>

    <Style Selector="ScrollBar:horizontal">
      <Setter Property="Height" Value="14" />
    </Style>

    <Style Selector="ScrollBar:vertical /template/ Thumb">
      <Setter Property="Width" Value="10" />
    </Style>

    <Style Selector="ScrollBar:horizontal /template/ Thumb">
      <Setter Property="Height" Value="10" />
    </Style>

    <Style Selector="ScrollBar /template/ Rectangle#TrackRect">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </Application.Styles>

</Application>
