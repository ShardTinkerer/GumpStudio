<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GumpStudio.App.ViewModels"
        x:Class="GumpStudio.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Icon="/Assets/gumpstudio.ico"
        Width="1280" Height="860"
        MinWidth="900" MinHeight="600">

  <!--
    The status line's two colours. A style rather than an assignment, so that
    nothing outside the view decides what a failure looks like - the view model
    reports only whether the message is one.
  -->
  <Window.Styles>
    <Style Selector="TextBlock#StatusText">
      <Setter Property="Foreground" Value="Silver" />
    </Style>
    <Style Selector="TextBlock#StatusText.error">
      <Setter Property="Foreground" Value="IndianRed" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <Menu DockPanel.Dock="Top" Name="MainMenu">
      <MenuItem Header="_File">
        <MenuItem Header="_New" Name="MenuNew" Command="{Binding NewCommand}"
                  InputGesture="Ctrl+N" />
        <MenuItem Header="_Open…" Name="MenuOpen" Command="{Binding OpenCommand}"
                  InputGesture="Ctrl+O" />
        <MenuItem Header="_Save" Name="MenuSave" Command="{Binding SaveCommand}"
                  InputGesture="Ctrl+S" />
        <MenuItem Header="Save _As…" Name="MenuSaveAs" Command="{Binding SaveAsCommand}" />
        <Separator />
        <MenuItem Header="_Import GumpStudio 1.8 file…" Name="MenuImportLegacy"
                  Command="{Binding ImportLegacyCommand}" />
        <MenuItem Header="Import gump _layout…" Name="MenuImportLayout"
                  Command="{Binding ImportLayoutCommand}" />
        <MenuItem Header="_Export" Name="MenuExport" />
        <Separator />
        <MenuItem Header="Set _client folder…" Name="MenuSetClient"
                  Command="{Binding SetClientCommand}" />
        <Separator />
        <MenuItem Header="E_xit" Name="MenuExit" Command="{Binding ExitCommand}" />
      </MenuItem>

      <MenuItem Header="_Edit" Name="MenuEditRoot">
        <MenuItem Header="{Binding UndoHeader}" Name="MenuUndo" Command="{Binding UndoCommand}"
                  InputGesture="Ctrl+Z" IsEnabled="{Binding CanUndo}" />
        <MenuItem Header="{Binding RedoHeader}" Name="MenuRedo" Command="{Binding RedoCommand}"
                  InputGesture="Ctrl+Y" IsEnabled="{Binding CanRedo}" />
        <Separator />
        <MenuItem Header="Cu_t" Name="MenuCut" Command="{Binding CutCommand}"
                  InputGesture="Ctrl+X" IsEnabled="{Binding CanCut}" />
        <MenuItem Header="_Copy" Name="MenuCopy" Command="{Binding CopyCommand}"
                  InputGesture="Ctrl+C" IsEnabled="{Binding CanCopy}" />
        <MenuItem Header="_Paste" Name="MenuPaste" Command="{Binding PasteCommand}"
                  InputGesture="Ctrl+V" />
        <Separator />
        <MenuItem Header="Select _all" Name="MenuSelectAll" Command="{Binding SelectAllCommand}"
                  InputGesture="Ctrl+A" />
        <MenuItem Header="_Delete" Name="MenuDelete" Command="{Binding DeleteCommand}"
                  InputGesture="Delete" IsEnabled="{Binding CanDelete}" />
        <MenuItem Header="_Group selection" Name="MenuGroup" Command="{Binding GroupCommand}"
                  InputGesture="Ctrl+G" IsEnabled="{Binding CanGroup}" />
        <MenuItem Header="_Ungroup" Name="MenuUngroup" Command="{Binding UngroupCommand}"
                  InputGesture="Ctrl+Shift+G" IsEnabled="{Binding CanUngroup}" />
        <Separator />
        <MenuItem Header="Bring to _front" Name="MenuBringToFront"
                  Command="{Binding BringToFrontCommand}" InputGesture="Ctrl+Shift+Up"
                  IsEnabled="{Binding CanReorder}" />
        <MenuItem Header="Bring for_ward" Name="MenuBringForward"
                  Command="{Binding BringForwardCommand}" InputGesture="Ctrl+Up"
                  IsEnabled="{Binding CanReorder}" />
        <MenuItem Header="Send back_ward" Name="MenuSendBackward"
                  Command="{Binding SendBackwardCommand}" InputGesture="Ctrl+Down"
                  IsEnabled="{Binding CanReorder}" />
        <MenuItem Header="Send to _back" Name="MenuSendToBack"
                  Command="{Binding SendToBackCommand}" InputGesture="Ctrl+Shift+Down"
                  IsEnabled="{Binding CanReorder}" />
        <Separator />
        <MenuItem Header="_Arrange" Name="MenuArrange" IsEnabled="{Binding CanArrange}">
          <MenuItem Header="Align _lefts" Name="MenuAlignLeft"
                    Command="{Binding AlignLeftCommand}" />
          <MenuItem Header="Align _rights" Name="MenuAlignRight"
                    Command="{Binding AlignRightCommand}" />
          <MenuItem Header="Align _tops" Name="MenuAlignTop" Command="{Binding AlignTopCommand}"
                    />
          <MenuItem Header="Align _bottoms" Name="MenuAlignBottom"
                    Command="{Binding AlignBottomCommand}" />
          <Separator />
          <MenuItem Header="Centre _horizontally" Name="MenuCentreH"
                    Command="{Binding CentreHorizontallyCommand}" />
          <MenuItem Header="Centre _vertically" Name="MenuCentreV"
                    Command="{Binding CentreVerticallyCommand}" />
          <Separator />
          <MenuItem Header="Equalise horizontal _spacing" Name="MenuSpaceH"
                    Command="{Binding SpaceHorizontallyCommand}" />
          <MenuItem Header="Equalise vertical spa_cing" Name="MenuSpaceV"
                    Command="{Binding SpaceVerticallyCommand}" />
        </MenuItem>
      </MenuItem>

      <MenuItem Header="_View">
        <MenuItem Header="Show page _0 beneath this page" Name="MenuShowPage0"
                  IsChecked="{Binding ShowSharedPage, Mode=TwoWay}" ToggleType="CheckBox" />
        <Separator />
        <MenuItem Header="Show _grid" Name="MenuShowGrid"
                  IsChecked="{Binding ShowGrid, Mode=TwoWay}" ToggleType="CheckBox" />
        <MenuItem Header="_Snap to grid" Name="MenuSnapToGrid"
                  IsChecked="{Binding SnapToGrid, Mode=TwoWay}" ToggleType="CheckBox" />
        <MenuItem Header="Grid _size…" Name="MenuGridSize"
                  Command="{Binding ChooseGridSizeCommand}" />
        <Separator />
        <MenuItem Header="Zoom _in" Name="MenuZoomIn" Command="{Binding ZoomInCommand}"
                  InputGesture="Ctrl+OemPlus" />
        <MenuItem Header="Zoom _out" Name="MenuZoomOut" Command="{Binding ZoomOutCommand}"
                  InputGesture="Ctrl+OemMinus" />
        <MenuItem Header="_Actual size" Name="MenuZoomReset"
                  Command="{Binding ZoomResetCommand}" InputGesture="Ctrl+D0" />
        <MenuItem Header="_Fit to window" Name="MenuZoomFit"
                  Command="{Binding ZoomToFitCommand}" />
        <Separator />
        <!--
          Hiding and showing a panel lives here rather than on the tab's close
          button: Dock's close removes a dockable from its owner outright, so
          nothing could bring it back, while hide stores it on the root for
          RestoreDockable to find.
        -->
        <MenuItem Header="_Toolbox panel" Name="MenuPanelToolbox"
                  IsChecked="{Binding ToolboxVisible, Mode=TwoWay}" ToggleType="CheckBox" />
        <MenuItem Header="_Elements panel" Name="MenuPanelElements"
                  IsChecked="{Binding ElementsVisible, Mode=TwoWay}" ToggleType="CheckBox" />
        <MenuItem Header="_Properties panel" Name="MenuPanelProperties"
                  IsChecked="{Binding PropertiesVisible, Mode=TwoWay}" ToggleType="CheckBox" />
        <MenuItem Header="_Cliloc panel" Name="MenuPanelCliloc"
                  IsChecked="{Binding ClilocVisible, Mode=TwoWay}" ToggleType="CheckBox" />
        <Separator />
        <MenuItem Header="_Reset panel layout" Name="MenuResetLayout"
                  Command="{Binding ResetLayoutCommand}" />
      </MenuItem>

      <MenuItem Header="_Gump">
        <MenuItem Header="_Properties…" Name="MenuGumpProperties"
                  Command="{Binding EditGumpPropertiesCommand}" />
      </MenuItem>

      <MenuItem Header="_Page" Name="MenuPageRoot">
        <MenuItem Header="_Add page" Name="MenuAddPage" Command="{Binding AddPageCommand}" />
        <MenuItem Header="_Insert page here" Name="MenuInsertPage"
                  Command="{Binding InsertPageCommand}" />
        <MenuItem Header="_Remove page" Name="MenuRemovePage"
                  Command="{Binding RemovePageCommand}" />
        <MenuItem Header="_Clear page" Name="MenuClearPage" Command="{Binding ClearPageCommand}"
                  />
        <Separator />
        <MenuItem Header="_Move selection to page" Name="MenuMoveToPage" />
      </MenuItem>

      <MenuItem Header="_Help">
        <MenuItem Header="_About GumpStudio…" Name="MenuAbout"
                  Command="{Binding ShowAboutCommand}" />
      </MenuItem>

    </Menu>

    <Border DockPanel.Dock="Bottom" Background="#1F1F23" Padding="8,4">
      <TextBlock Name="StatusText" Text="{Binding Status}"
                 Classes.error="{Binding IsStatusError}" />
    </Border>

    <!--
      The side panels are Dock tools rather than fixed grid columns, so each
      one can be re-tabbed, stacked, floated or pinned away and the canvas
      keeps the middle.

      None of the tools carries its content here. Dock treats what a Tool holds
      in XAML as a template it builds when the tab is first shown, which puts
      the controls outside this window's name scope and out of reach of the
      constructor. The panels are separate views, and the constructor hands
      each one to its tool instead.
    -->
    <DockControl x:Name="Layout" InitializeLayout="True" InitializeFactory="True">

      <DockControl.Factory>
        <Factory />
      </DockControl.Factory>

      <RootDock x:Name="Root" Id="Root" IsCollapsable="False"
                DefaultDockable="{Binding #MainLayout}">

        <ProportionalDock x:Name="MainLayout" Id="MainLayout" Orientation="Horizontal">

          <ToolDock x:Name="ToolboxPane" Id="ToolboxPane" Proportion="0.13" Alignment="Left">
            <!--
              Nothing here can be closed. Closing a tool hides it, and no menu
              brings one back yet, so a stray click on a tab's close button
              would cost a panel for the rest of the session.
            -->
            <Tool x:Name="ToolboxTool" Id="ToolboxTool" Title="Toolbox" CanClose="False" />
          </ToolDock>

          <ProportionalDockSplitter x:Name="LeftSplitter" Id="LeftSplitter" />

          <!--
            The canvas and the cliloc browser share the middle column. The
            browser is a wide, short list - an id and a sentence - so it belongs
            under the canvas rather than beside it, where it would either crush
            the gump or truncate every string.
          -->
          <ProportionalDock x:Name="CenterPane" Id="CenterPane"
                            Orientation="Vertical" Proportion="0.6">

            <DocumentDock x:Name="CanvasPane" Id="CanvasPane" Proportion="0.75"
                          CanCreateDocument="False" IsCollapsable="False">
              <Document x:Name="GumpDocument" Id="GumpDocument" Title="Gump" CanClose="False" />
            </DocumentDock>

            <ProportionalDockSplitter x:Name="ClilocSplitter" Id="ClilocSplitter" />

            <ToolDock x:Name="ClilocPane" Id="ClilocPane" Proportion="0.25" Alignment="Bottom">
              <Tool x:Name="ClilocTool" Id="ClilocTool" Title="Cliloc" CanClose="False" />
            </ToolDock>

          </ProportionalDock>

          <ProportionalDockSplitter x:Name="RightSplitter" Id="RightSplitter" />

          <ProportionalDock x:Name="RightPane" Id="RightPane" Orientation="Vertical" Proportion="0.27">

            <ToolDock x:Name="ElementsPane" Id="ElementsPane" Proportion="0.35" Alignment="Right">
              <Tool x:Name="ElementsTool" Id="ElementsTool" Title="Elements" CanClose="False" />
            </ToolDock>

            <ProportionalDockSplitter x:Name="PropertiesSplitter" Id="PropertiesSplitter" />

            <ToolDock x:Name="PropertiesPane" Id="PropertiesPane" Proportion="0.65" Alignment="Right">
              <Tool x:Name="PropertiesTool" Id="PropertiesTool" Title="Properties" CanClose="False" />
            </ToolDock>

          </ProportionalDock>

        </ProportionalDock>
      </RootDock>

    </DockControl>

  </DockPanel>
</Window>
