<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GumpStudio.App.Controls"
        x:Class="GumpStudio.App.MainWindow"
        Title="GumpStudio"
        Width="1280" Height="860"
        MinWidth="900" MinHeight="600">

  <DockPanel>

    <Menu DockPanel.Dock="Top" Name="MainMenu">
      <MenuItem Header="_File">
        <MenuItem Header="_New" Name="MenuNew" InputGesture="Ctrl+N" />
        <MenuItem Header="_Open…" Name="MenuOpen" InputGesture="Ctrl+O" />
        <MenuItem Header="_Save" Name="MenuSave" InputGesture="Ctrl+S" />
        <MenuItem Header="Save _As…" Name="MenuSaveAs" />
        <Separator />
        <MenuItem Header="_Import GumpStudio 1.8 file…" Name="MenuImportLegacy" />
        <MenuItem Header="_Export" Name="MenuExport" />
        <Separator />
        <MenuItem Header="Set _client folder…" Name="MenuSetClient" />
        <Separator />
        <MenuItem Header="E_xit" Name="MenuExit" />
      </MenuItem>

      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" Name="MenuUndo" InputGesture="Ctrl+Z" />
        <MenuItem Header="_Redo" Name="MenuRedo" InputGesture="Ctrl+Y" />
        <Separator />
        <MenuItem Header="Cu_t" Name="MenuCut" InputGesture="Ctrl+X" />
        <MenuItem Header="_Copy" Name="MenuCopy" InputGesture="Ctrl+C" />
        <MenuItem Header="_Paste" Name="MenuPaste" InputGesture="Ctrl+V" />
        <Separator />
        <MenuItem Header="Select _all" Name="MenuSelectAll" InputGesture="Ctrl+A" />
        <MenuItem Header="_Delete" Name="MenuDelete" InputGesture="Delete" />
        <MenuItem Header="_Group selection" Name="MenuGroup" InputGesture="Ctrl+G" />
        <MenuItem Header="_Ungroup" Name="MenuUngroup" InputGesture="Ctrl+Shift+G" />
        <Separator />
        <MenuItem Header="Bring to _front" Name="MenuBringToFront" InputGesture="Ctrl+Shift+Up" />
        <MenuItem Header="Bring for_ward" Name="MenuBringForward" InputGesture="Ctrl+Up" />
        <MenuItem Header="Send back_ward" Name="MenuSendBackward" InputGesture="Ctrl+Down" />
        <MenuItem Header="Send to _back" Name="MenuSendToBack" InputGesture="Ctrl+Shift+Down" />
        <Separator />
        <MenuItem Header="_Arrange">
          <MenuItem Header="Align _lefts" Name="MenuAlignLeft" />
          <MenuItem Header="Align _rights" Name="MenuAlignRight" />
          <MenuItem Header="Align _tops" Name="MenuAlignTop" />
          <MenuItem Header="Align _bottoms" Name="MenuAlignBottom" />
          <Separator />
          <MenuItem Header="Centre _horizontally" Name="MenuCentreH" />
          <MenuItem Header="Centre _vertically" Name="MenuCentreV" />
          <Separator />
          <MenuItem Header="Equalise horizontal _spacing" Name="MenuSpaceH" />
          <MenuItem Header="Equalise vertical spa_cing" Name="MenuSpaceV" />
        </MenuItem>
      </MenuItem>

      <MenuItem Header="_View">
        <MenuItem Header="Show page _0 beneath this page" Name="MenuShowPage0"
                  ToggleType="CheckBox" IsChecked="True" />
        <Separator />
        <MenuItem Header="Show _grid" Name="MenuShowGrid" ToggleType="CheckBox" />
        <MenuItem Header="_Snap to grid" Name="MenuSnapToGrid" ToggleType="CheckBox" />
        <MenuItem Header="Grid _size…" Name="MenuGridSize" />
      </MenuItem>

      <MenuItem Header="_Gump">
        <MenuItem Header="_Properties…" Name="MenuGumpProperties" />
      </MenuItem>

      <MenuItem Header="_Page" Name="MenuPageRoot">
        <MenuItem Header="_Add page" Name="MenuAddPage" />
        <MenuItem Header="_Remove page" Name="MenuRemovePage" />
        <Separator />
        <MenuItem Header="_Move selection to page" Name="MenuMoveToPage" />
      </MenuItem>

      <MenuItem Header="_Plugins" Name="MenuPlugins" />
    </Menu>

    <Border DockPanel.Dock="Bottom" Background="#1F1F23" Padding="8,4">
      <TextBlock Name="StatusText" Foreground="#C8C8C8" Text="Ready." />
    </Border>

    <!--
      Both side panels were fixed widths in a DockPanel, so nothing could be
      widened when its contents did not fit. They are grid columns with
      splitters now, each with a minimum so a panel cannot be dragged away
      entirely.
    -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="150" MinWidth="110" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*" MinWidth="200" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="340" MinWidth="240" />
      </Grid.ColumnDefinitions>

      <!-- Toolbox -->
      <Border Grid.Column="0" Background="#26262A" Padding="6">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Toolbox" Foreground="#9A9AA0"
                     FontWeight="Bold" Margin="2,2,2,6" />
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl Name="Toolbox">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="3" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="#1F1F23" />

      <!-- Pages + canvas -->
      <DockPanel Grid.Column="2">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Name="PageTabs"
                    Background="#26262A" Spacing="2" />

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <controls:GumpCanvas Name="Canvas" Width="1024" Height="768"
                               HorizontalAlignment="Left" VerticalAlignment="Top" />
        </ScrollViewer>
      </DockPanel>

      <GridSplitter Grid.Column="3" ResizeDirection="Columns" Background="#1F1F23" />

      <!-- Element list and properties -->
      <Border Grid.Column="4" Background="#26262A" Padding="6">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="70" />
            <RowDefinition Height="4" />
            <!-- The properties header lives inside this row rather than in one
                 of its own: a splitter resizes the rows either side of it, and
                 an Auto header between them would be what got resized. -->
            <RowDefinition Height="2*" MinHeight="120" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,2,2,6" Spacing="6">
            <TextBlock Text="Elements" Foreground="#9A9AA0" FontWeight="Bold" />
            <!-- Drawing order is the list order, and it is not obvious which end
                 is which until something is hidden behind something else. -->
            <TextBlock Text="back → front" Foreground="#6A6A70" VerticalAlignment="Center" />
          </StackPanel>

          <ListBox Grid.Row="1" Name="ElementList" Background="#1F1F23" />

          <GridSplitter Grid.Row="2" ResizeDirection="Rows" Background="#1F1F23" />

          <DockPanel Grid.Row="3">
            <TextBlock DockPanel.Dock="Top" Text="Properties" Foreground="#9A9AA0"
                       FontWeight="Bold" Margin="2,8,2,6" />

            <!--
              AllowAutoHide off, and a right margin on the content to match.
              The Fluent scroll bar floats over what it is scrolling by default,
              which put it on top of the browse button at the end of an id row.
            -->
            <ScrollViewer AllowAutoHide="False"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel Name="PropertyPanel" Spacing="4" Margin="0,0,10,0" />
            </ScrollViewer>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>

  </DockPanel>
</Window>
