<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Description>Avalonia desktop shell for GumpStudio.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Views are XAML; the generated partials do not carry doc comments. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Dock.Avalonia" />
    <PackageReference Include="Dock.Model.Avalonia" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../GumpStudio.Core/GumpStudio.Core.csproj" />
    <ProjectReference Include="../GumpStudio.Rendering/GumpStudio.Rendering.csproj" />
    <ProjectReference Include="../GumpStudio.Converters/GumpStudio.Converters.csproj" />
  </ItemGroup>

  <!--
    IL3051 fires inside System.Formats.Nrbf 10.0.11, which Microsoft ships:
    SZArrayRecord<T>.Deserialize overrides a RequiresDynamicCode member without
    carrying the attribute. It is an annotation-consistency check, raised
    whether or not the method is reachable, and the legacy importer never calls
    it — it walks the records by hand with GetArray and GetRawValue and
    deliberately never activates a type. Revisit when the package is fixed.

    Nothing else here needs an AOT accommodation: the converters are ordinary
    referenced code now, so a NativeAOT publish and an ordinary build run the
    same path. They used to be assemblies discovered from a Plugins folder,
    which an AOT image cannot load at all — hence a second registration route
    behind #if STATIC_PLUGINS, and two MSBuild copy targets to deploy them.
  -->
  <!--
    IL2104 and IL3053 are the per-assembly roll-ups for Dock. Its Fluent theme
    binds a dockable's Title and CanClose by name rather than with compiled
    bindings, and its container generator reflects over whatever an ItemsSource
    hands it. Both are library code and neither is something this project can
    annotate; the published binary is exercised by hand after a Dock bump. The
    warnings that matter still fail the build: an assembly roll-up only covers
    code shipped in a package, and this project's own IL2026 and IL3050 are
    reported individually.
  -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <NoWarn>$(NoWarn);IL3051;IL2104;IL3053</NoWarn>
  </PropertyGroup>

</Project>
