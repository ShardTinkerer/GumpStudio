<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Description>Avalonia desktop shell for GumpStudio.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Views are XAML; the generated partials do not carry doc comments. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Dock.Avalonia" />
    <PackageReference Include="Dock.Model.Avalonia" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../GumpStudio.Core/GumpStudio.Core.csproj" />
    <ProjectReference Include="../GumpStudio.Rendering/GumpStudio.Rendering.csproj" />
    <ProjectReference Include="../GumpStudio.Converters/GumpStudio.Converters.csproj" />
  </ItemGroup>

  <!--
    Nothing here needs an AOT accommodation of its own: the converters are
    ordinary referenced code, so a NativeAOT publish and an ordinary build run
    the same path. They used to be assemblies discovered from a Plugins folder,
    which an AOT image cannot load at all — hence a second registration route
    behind #if STATIC_PLUGINS, and two MSBuild copy targets to deploy them.

    The trim warnings Dock brings in are suppressed for every AOT publish in
    Directory.Build.props, alongside the ones from System.Formats.Nrbf.
  -->

</Project>
