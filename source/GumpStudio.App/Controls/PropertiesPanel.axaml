<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GumpStudio.App.Controls.PropertiesPanel">

  <!--
    Nothing here fends off the scroll bar any more. Under Fluent it floated over
    what it was scrolling and landed on the browse button at the end of an id
    row, which cost an AllowAutoHide="False" and a matching right margin. The
    Simple theme gives it a column of its own, so the rows simply end where it
    begins.
  -->
  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Padding="6">
    <StackPanel Name="_rows" Spacing="4" />
  </ScrollViewer>

</UserControl>
