<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GumpStudio.App.Controls.ArtBrowserWindow"
        Title="Browse art"
        Width="900" Height="640"
        WindowStartupLocation="CenterOwner">

  <DockPanel Margin="8">

    <!-- Search -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,8">
      <TextBlock Grid.Column="0" Text="Filter" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox Grid.Column="1" Name="FilterBox"
               Watermark="id (decimal or 0x…) or name" />
      <ToggleButton Grid.Column="2" Name="GalleryToggle" Content="Gallery"
                    Margin="8,0,0,0" MinWidth="80"
                    ToolTip.Tip="Show the art as a grid of tiles instead of a list." />
      <TextBlock Grid.Column="3" Name="CountText" VerticalAlignment="Center"
                 Margin="8,0,0,0" Foreground="Gray" />
    </Grid>

    <!-- Buttons -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
      <Button Name="CancelButton" Content="Cancel" MinWidth="90" />
      <Button Name="AcceptButton" Content="Select" MinWidth="90" IsDefault="True" />
    </StackPanel>

    <!-- Preview -->
    <Border DockPanel.Dock="Right" Width="260" Margin="8,0,0,0"
            BorderBrush="#40FFFFFF" BorderThickness="1" Padding="8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Name="PreviewTitle" Text="Nothing selected"
                   FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,4" />
        <TextBlock DockPanel.Dock="Top" Name="PreviewDetail" Foreground="Gray"
                   TextWrapping="Wrap" Margin="0,0,0,8" />
        <Border Background="#20000000">
          <Image Name="PreviewImage" Stretch="None"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 RenderOptions.BitmapInterpolationMode="None" />
        </Border>
      </DockPanel>
    </Border>

    <!-- Results -->
    <Border BorderBrush="#40FFFFFF" BorderThickness="1">
      <ListBox Name="Results" SelectionMode="Single">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel Orientation="Vertical" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
      </ListBox>
    </Border>

  </DockPanel>
</Window>
