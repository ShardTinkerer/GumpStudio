# Build output. UseArtifactsOutput puts every project's bin, obj and publish
# under one root (Directory.Build.props), so artifacts/ is the only directory
# a build writes to. The bin/obj patterns remain as a safety net for a project
# built outside the repository configuration.
artifacts/
[Bb]in/
[Oo]bj/

# The original 1.8 binaries, when kept beside the rewrite as a behaviour
# reference. They are not redistributable and must never be committed.
external/

# IDE and editor state
.vs/
.vscode/
.idea/
*.suo
*.user
*.rsuser
*.userosscache
*.sln.docstates
*.userprefs
_ReSharper*/
*.DotSettings.user

# Test and diagnostic output
[Tt]est[Rr]esults/
*.trx
*.coverage
*.coveragexml
*.binlog
*.log
*.sarif

# Crash and scratch files
mono_crash.*
*.tmp
*.pdb
*~
